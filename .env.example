PORT=3000
NODE_ENV=development
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=1h
# Optional for local development (SQLite is used when absent).
# Required for durable production storage. Use your PostgreSQL connection URL.
DATABASE_SCHEMA=gatehouse
DATABASE_URL=
DATABASE_PATH=./data/gatehouse.sqlite
